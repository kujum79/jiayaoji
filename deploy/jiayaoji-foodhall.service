[Unit]
Description=JiaYaoJi FoodHall auto-publish (3 diet + 3 recipe, audit + pick for today)
After=network-online.target jiayaoji.service
Wants=network-online.target

[Service]
Type=oneshot
# V402: 双轨共 6 篇生成 + 6 次合规审核，耗时翻倍；放宽 oneshot 启动超时（默认 90s 会中途被杀）
TimeoutStartSec=600
# 城市可用环境变量覆盖：Environment=JIAYAOJI_CITY=杭州
ExecStart=/bin/bash /var/www/jiayaoji/deploy/foodhall_autopub.sh
